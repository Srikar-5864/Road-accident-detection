<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Road Accident Reporting</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
body{font-family:system-ui,sans-serif;margin:0;background:#f4f6f8;color:#1b2430}
header{background:#b3261e;color:#fff;padding:12px 16px}
nav button{margin-right:8px;padding:6px 12px;border:0;border-radius:6px;cursor:pointer}
nav button.on{background:#fff;font-weight:600}
main{max-width:820px;margin:16px auto;padding:0 12px}
.card{background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;box-shadow:0 1px 3px #0002}
input,textarea,select{width:100%;box-sizing:border-box;padding:8px;margin:4px 0 10px;border:1px solid #bbb;border-radius:6px}
button.p{background:#b3261e;color:#fff;border:0;padding:9px 16px;border-radius:6px;cursor:pointer}
.warn{background:#fff3cd;padding:10px;border-radius:6px;margin-bottom:12px}
.err{color:#b3261e}.ok{color:#1b7f3b}
table{width:100%;border-collapse:collapse;font-size:14px}td,th{border-bottom:1px solid #ddd;padding:6px;text-align:left}
#map{height:260px;border-radius:8px;margin-bottom:8px}
</style></head><body>
<div id="root"></div>
<script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone@7.25.6/babel.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script type="text/babel">
const {useState,useEffect,useRef}=React;
const api=async(p,o={},tok)=>{const h={...(o.headers||{})};if(tok)h.Authorization="Bearer "+tok;
 const r=await fetch("/api"+p,{...o,headers:h});const d=await r.json().catch(()=>({}));
 if(!r.ok)throw new Error(typeof d.detail==="string"?d.detail:JSON.stringify(d.detail||"Request failed"));return d;};
const osm=(a,b)=>`https://www.openstreetmap.org/?mlat=${a}&mlon=${b}#map=17/${a}/${b}`;

function Report({tok}){
 const [f,setF]=useState({description:"",severity:"Unknown",latitude:"",longitude:""});
 const [img,setImg]=useState(null),[res,setRes]=useState(null),[err,setErr]=useState(""),[busy,setBusy]=useState(false);
 const mapEl=useRef(),map=useRef(),mk=useRef();
 const setPos=(la,lo)=>{setF(x=>({...x,latitude:la.toFixed(5),longitude:lo.toFixed(5)}));
  if(mk.current)mk.current.setLatLng([la,lo]);else mk.current=L.marker([la,lo]).addTo(map.current);map.current.setView([la,lo],15);};
 useEffect(()=>{map.current=L.map(mapEl.current).setView([12.9716,77.5946],11);
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"© OpenStreetMap"}).addTo(map.current);
  map.current.on("click",e=>setPos(e.latlng.lat,e.latlng.lng));},[]);
 const locate=()=>navigator.geolocation?navigator.geolocation.getCurrentPosition(p=>setPos(p.coords.latitude,p.coords.longitude),
  ()=>setErr("Location denied - click the map or type coordinates manually.")):setErr("Geolocation unsupported - pick manually.");
 const submit=async()=>{setErr("");setRes(null);setBusy(true);
  try{const fd=new FormData();Object.entries(f).forEach(([k,v])=>fd.append(k,v));fd.append("reported_at",new Date().toISOString());
   if(img)fd.append("image",img);setRes(await api("/incidents",{method:"POST",body:fd},tok));}
  catch(e){setErr(e.message)}setBusy(false);};
 return <div>
  <div className="warn"><b>In a real emergency, call your local emergency number now.</b> Do not wait for this app or its AI result.</div>
  <div className="card"><h3>Report an accident</h3>
   <label>Description</label><textarea rows="3" value={f.description} onChange={e=>setF({...f,description:e.target.value})}/>
   <label>Severity estimate</label><select value={f.severity} onChange={e=>setF({...f,severity:e.target.value})}>
    {["Unknown","Minor","Serious","Critical"].map(s=><option key={s}>{s}</option>)}</select>
   <button onClick={locate}>📍 Use my location</button> <small>or click the map</small>
   <div id="map" ref={mapEl} style={{marginTop:8}}/>
   <div style={{display:"flex",gap:8}}><input placeholder="Latitude" value={f.latitude} onChange={e=>setF({...f,latitude:e.target.value})}/>
    <input placeholder="Longitude" value={f.longitude} onChange={e=>setF({...f,longitude:e.target.value})}/></div>
   <label>Photo (optional, JPEG/PNG/WEBP, ≤5 MB)</label><input type="file" accept="image/*" onChange={e=>setImg(e.target.files[0])}/>
   {img&&<img src={URL.createObjectURL(img)} style={{maxWidth:200,display:"block",marginBottom:8}}/>}
   <button className="p" disabled={busy} onClick={submit}>{busy?"Submitting…":"Submit report"}</button>
   {err&&<p className="err">{err}</p>}</div>
  {res&&<div className="card"><h3 className="ok">Report saved: {res.incident_id}</h3><p>{res.message}</p>
   <p><b>AI:</b> {res.ai_prediction?`${res.ai_prediction} (${(res.ai_confidence*100).toFixed(0)}% confidence) - preliminary, needs human verification.`:res.ai_note}</p>
   <p><small>A test alert was recorded; no real emergency service has been contacted. Keep your incident ID to track status.</small></p></div>}
 </div>;}

function Track(){
 const [id,setId]=useState(""),[d,setD]=useState(null),[err,setErr]=useState("");
 const go=async()=>{setErr("");setD(null);try{setD(await api("/incidents/"+id.trim().toUpperCase()))}catch(e){setErr(e.message)}};
 return <div className="card"><h3>Track a report</h3><input placeholder="INC-1001" value={id} onChange={e=>setId(e.target.value)}/>
  <button className="p" onClick={go}>Track</button>{err&&<p className="err">{err}</p>}
  {d&&<div><p><b>{d.incident_id}</b> - status: <b>{d.status}</b></p><p>Reported: {d.created_at} UTC</p>
   <p>Approx. location: <a href={osm(d.latitude,d.longitude)} target="_blank">map</a> (public view is rounded for privacy)</p>
   <b>History</b><ul>{d.history.map((h,i)=><li key={i}>{h.status} - {h.changed_at}</li>)}</ul></div>}</div>;}

function Admin({tok,setTok}){
 const [em,setEm]=useState("admin@example.com"),[pw,setPw]=useState(""),[err,setErr]=useState("");
 const [q,setQ]=useState(""),[rows,setRows]=useState([]),[st,setSt]=useState({}),[filter,setFilter]=useState(""),[sel,setSel]=useState(null),[notes,setNotes]=useState([]);
 const load=async()=>{try{setRows(await api("/incidents"+(filter?"?status="+filter:""),{},tok));setSt(await api("/stats",{},tok))}catch(e){setErr(e.message);if(/Login|Admin/.test(e.message))setTok("")}};
 useEffect(()=>{if(tok)load()},[tok,filter]);
 const login=async()=>{setErr("");try{const r=await api("/auth/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:em,password:pw})});
  if(r.role!=="admin")return setErr("Not an admin account");setTok(r.token)}catch(e){setErr(e.message)}};
 const setStatus=async(id,s)=>{try{await api(`/incidents/${id}/status`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:s})},tok);load()}catch(e){setErr(e.message)}};
 const openN=async id=>{setSel(id);setNotes(await api(`/incidents/${id}/notifications`,{},tok))};
 const retry=async()=>{await api(`/incidents/${sel}/notifications/retry`,{method:"POST"},tok);openN(sel)};
 if(!tok)return <div className="card"><h3>Admin login</h3><input value={em} onChange={e=>setEm(e.target.value)}/>
  <input type="password" placeholder="Password" value={pw} onChange={e=>setPw(e.target.value)}/><button className="p" onClick={login}>Login</button>{err&&<p className="err">{err}</p>}</div>;
 return <div><div className="card"><h3>Dashboard</h3><p>Total {st.total} · Reported {st.Reported} · Verified {st.Verified} · Responding {st.Responding} · Resolved {st.Resolved}</p>
  <div style={{display:"flex",gap:20,flexWrap:"wrap"}}><div style={{flex:1,minWidth:240}}><b>By status</b><Bars data={["Reported","Verified","Responding","Resolved","Duplicate","Rejected"].map(k=>({k,v:st[k]||0}))}/></div>
   <div style={{flex:1,minWidth:240}}><b>Last 7 days</b><Bars data={(st.by_day||[]).map(d=>({k:d.day.slice(5),v:d.count}))}/></div></div>
  <input placeholder="Search by ID or description" value={q} onChange={e=>setQ(e.target.value)} style={{marginTop:12}}/>
  <select value={filter} onChange={e=>setFilter(e.target.value)}><option value="">All statuses</option>{["Reported","Verified","Responding","Resolved","Duplicate","Rejected"].map(s=><option key={s}>{s}</option>)}</select>
  {err&&<p className="err">{err}</p>}
  <div style={{overflowX:"auto"}}><table><thead><tr><th>Photo</th><th>ID</th><th>Description</th><th>AI</th><th>Location</th><th>Status</th><th></th></tr></thead><tbody>
  {rows.filter(r=>(r.incident_id+" "+r.description).toLowerCase().includes(q.toLowerCase())).map(r=><tr key={r.incident_id}><td>{r.image_path?<Thumb id={r.incident_id} tok={tok}/>:"-"}</td><td>{r.incident_id}</td><td>{r.description.slice(0,60)}</td>
   <td>{r.ai_prediction?`${r.ai_prediction} ${(r.ai_confidence*100).toFixed(0)}%`:"-"}</td>
   <td><a href={osm(r.latitude,r.longitude)} target="_blank">map</a></td>
   <td><select value={r.status} onChange={e=>setStatus(r.incident_id,e.target.value)}>{["Reported","Verified","Responding","Resolved","Duplicate","Rejected"].map(s=><option key={s}>{s}</option>)}</select></td>
   <td><button onClick={()=>openN(r.incident_id)}>Alerts</button></td></tr>)}</tbody></table></div>
  <button onClick={()=>setTok("")} style={{marginTop:8}}>Logout</button></div>
  {sel&&<div className="card"><h3>Notifications for {sel}</h3><table><tbody>{notes.map(n=><tr key={n.notification_id}><td>{n.recipient}</td><td className={n.delivery_status==="Sent"?"ok":"err"}>{n.delivery_status}</td><td>{n.created_at}</td></tr>)}</tbody></table>
   <button onClick={retry}>Retry failed</button></div>}</div>;}

const Stat=({n,l})=><div className="card" style={{flex:1,textAlign:"center",minWidth:120}}><div style={{fontSize:30,fontWeight:700}}>{n==null?"-":n}</div><small>{l}</small></div>;
const COL={Reported:"#d32f2f",Verified:"#f57c00",Responding:"#1976d2",Resolved:"#2e7d32"};

function Bars({data}){const mx=Math.max(1,...data.map(d=>d.v));
 return <div>{data.map(d=><div key={d.k} style={{display:"flex",alignItems:"center",gap:6,fontSize:13,margin:"3px 0"}}>
  <span style={{width:80}}>{d.k}</span><div style={{background:"#b3261e",height:14,width:(d.v/mx*55)+"%",minWidth:d.v?4:0,borderRadius:3}}/><span>{d.v}</span></div>)}</div>;}

function Thumb({id,tok}){const [u,setU]=useState(null);
 useEffect(()=>{let url;fetch(`/api/incidents/${id}/image`,{headers:{Authorization:"Bearer "+tok}}).then(r=>r.ok?r.blob():null)
  .then(b=>{if(b){url=URL.createObjectURL(b);setU(url)}}).catch(()=>{});return()=>{if(url)URL.revokeObjectURL(url)}},[id]);
 return u?<img src={u} style={{width:48,height:48,objectFit:"cover",borderRadius:4}}/>:<small>-</small>;}

function Home({go}){
 const [s,setS]=useState(null);
 useEffect(()=>{api("/public/stats").then(setS).catch(()=>{})},[]);
 return <div>
  <div className="card"><h2 style={{marginTop:0}}>Report road accidents faster</h2>
   <p>Share what happened, where it happened and an optional photo. An AI model gives a preliminary image check, and responders can review and track every report.</p>
   <button className="p" onClick={()=>go("report")}>Report an accident</button> <button onClick={()=>go("track")}>Track a report</button></div>
  <div className="warn"><b>Emergency?</b> Call your local emergency number first (112 in India). Don't wait for this app or its AI result.</div>
  <div style={{display:"flex",gap:10,flexWrap:"wrap"}}><Stat n={s&&s.total} l="Total reports"/><Stat n={s&&s.active} l="Active"/><Stat n={s&&s.resolved} l="Resolved"/><Stat n={s&&s.last24h} l="Last 24 hours"/></div>
  <div className="card"><h3>How it works</h3><ol><li>Describe the incident and share your location</li><li>Optionally upload a photo for a preliminary AI check</li>
   <li>Get an incident ID and test alerts go to the configured responders</li><li>Admins verify the report and update its status</li><li>Track progress with your incident ID</li></ol></div>
  <div className="card"><h3>Explore</h3><button onClick={()=>go("map")}>Incident map & hotspots</button> <button onClick={()=>go("safety")}>Safety guide</button></div></div>;}

function MapView(){
 const el=useRef(),[d,setD]=useState(null);
 useEffect(()=>{api("/public/map").then(setD).catch(()=>setD({points:[],hotspots:[]}))},[]);
 useEffect(()=>{if(!d)return;const m=L.map(el.current).setView([12.9716,77.5946],11);
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"© OpenStreetMap"}).addTo(m);
  d.hotspots.forEach(h=>L.circle([h.lat,h.lng],{radius:400+h.count*150,color:"#d32f2f",fillOpacity:.2}).bindPopup(`Hotspot: ${h.count} reports`).addTo(m));
  d.points.forEach(p=>L.circleMarker([p.lat,p.lng],{radius:7,color:COL[p.status]||"#555",fillOpacity:.9}).bindPopup(`${p.id} - ${p.status}`).addTo(m));
  if(d.points.length)m.fitBounds(d.points.map(p=>[p.lat,p.lng]),{maxZoom:15,padding:[30,30]});
  return()=>m.remove()},[d]);
 return <div><div className="card"><h3>Incident map</h3>
  <div>{Object.entries(COL).map(([k,c])=><span key={k} style={{marginRight:12}}><span style={{color:c}}>●</span> {k}</span>)}<span style={{color:"#d32f2f"}}>◯</span> Hotspot</div>
  <div id="map" ref={el} style={{height:380,marginTop:8}}/><small>Locations are rounded for privacy. Hotspots are ~1 km areas with 2+ reports.</small></div>
  <div className="card"><h3>Hotspots</h3>{d&&d.hotspots.length?<table><tbody>{d.hotspots.map((h,i)=><tr key={i}><td>Area near {h.lat}, {h.lng}</td><td>{h.count} reports</td>
   <td><a href={osm(h.lat,h.lng)} target="_blank">map</a></td></tr>)}</tbody></table>:<p>No hotspots yet. They appear when 2+ reports fall in the same area.</p>}</div></div>;}

function Safety(){
 return <div><div className="card"><h3>Emergency numbers (India)</h3>
  <table><tbody><tr><td><b>112</b></td><td>National emergency number</td></tr><tr><td><b>108</b></td><td>Ambulance (in many states)</td></tr><tr><td><b>100</b></td><td>Police</td></tr></tbody></table>
  <small>Numbers vary by country and region. Check your local emergency numbers.</small></div>
  <div className="card"><h3>If you witness an accident</h3><ol>
   <li><b>Stay safe.</b> Park away from traffic, switch on hazard lights, and don't stand in the road.</li>
   <li><b>Call emergency services immediately.</b> Give the exact location, number of people hurt and any hazards (fire, fuel leak).</li>
   <li><b>Don't move seriously injured people</b> unless they are in immediate danger, such as a fire.</li>
   <li><b>Control heavy bleeding</b> by pressing firmly on the wound with a clean cloth.</li>
   <li><b>Don't remove a motorcyclist's helmet</b> unless they can't breathe.</li>
   <li><b>Stay calm and stay with the injured</b> until help arrives, and don't give them food or drink.</li>
   <li><b>Then report it here</b> so the incident can be recorded and tracked.</li></ol>
  <small>General guidance only. It does not replace first-aid training or professional advice.</small></div></div>;}

function App(){
 const [tab,setTab]=useState("home"),[tok,setTok]=useState("");
 return <div><header><h2 style={{margin:"0 0 8px"}}>🚨 Road Accident Reporting & Alert System</h2>
  <nav style={{display:"flex",flexWrap:"wrap",gap:6}}>{[["home","Home"],["report","Report"],["track","Track"],["map","Map & Hotspots"],["safety","Safety"],["admin","Admin"]].map(([k,l])=><button key={k} className={tab===k?"on":""} onClick={()=>setTab(k)}>{l}</button>)}</nav></header>
  <main>{tab==="home"&&<Home go={setTab}/>}{tab==="map"&&<MapView/>}{tab==="safety"&&<Safety/>}{tab==="report"&&<Report tok={tok}/>}{tab==="track"&&<Track/>}{tab==="admin"&&<Admin tok={tok} setTok={setTok}/>}</main></div>;}
ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script></body></html>
